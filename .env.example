# 项目配置模板。复制为 .env 后在本机填写密钥和数据库配置。
DEEPSEEK_API_KEY=
ORDER_DATABASE_URL=
AFTER_SALES_POSTGRES_PASSWORD=
AFTER_SALES_POSTGRES_PORT=55432
# Docker 工作台默认在宿主机的 8766 端口，与本机直接运行的 8765 分开。
AFTER_SALES_DOCKER_PORT=8766
# 启动本项目的 Milvus 后填写 http://127.0.0.1:19531。
MILVUS_URL=
# 设置为1会在首次检索时向 mall_policy_hybrid_e5_v3 写入双路索引。
MALL_PERSISTENT_DENSE=1
# 三路RRF后进行窗口排序，再与原融合名次合并，避免纯语义排序覆盖词法证据。
MALL_WINDOW_RERANK=1
